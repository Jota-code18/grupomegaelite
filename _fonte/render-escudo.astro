---
// Página TEMPORÁRIA de renderização — usada só por scripts/render-escudo.mjs
// para capturar os quadros do vídeo do escudo. Não é linkada em lugar nenhum.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>render escudo</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #08080a;
      }
      #palco {
        /* Precisa bater com LARGURA/ALTURA em scripts/render-escudo.mjs. */
        width: 1400px;
        height: 1050px;
        /* Mesma base escura do palco do herói: o vídeo cobre o palco inteiro
           e o degradê dourado entra por cima, via CSS. */
        background:
          radial-gradient(70% 70% at 50% 46%, rgba(250, 201, 34, 0.2) 0%, transparent 62%),
          linear-gradient(180deg, #101014 0%, #08080a 100%);
      }
      model-viewer {
        width: 100%;
        height: 100%;
        --poster-color: transparent;
        --progress-bar-color: transparent;
        --progress-mask: transparent;
      }
    </style>
  </head>
  <body>
    <div id="palco">
      <model-viewer
        id="mv"
        src="/models/elite-3d.glb"
        alt="escudo"
        interaction-prompt="none"
        shadow-intensity="0.85"
        shadow-softness="1"
        exposure="0.75"
        environment-image="neutral"
        camera-orbit="0deg 86deg 95%"
        loading="eager"
        disable-zoom
        disable-pan
      ></model-viewer>
    </div>

    <script>
      import '@google/model-viewer';

      const mv = document.getElementById('mv') as HTMLElement & {
        updateComplete: Promise<unknown>;
      };
      const janela = window as unknown as {
        __pronto: Promise<void>;
        __orbita: (theta: number, phi: number) => Promise<void>;
      };

      janela.__pronto = new Promise<void>((resolve) => {
        mv.addEventListener('load', () => resolve(), { once: true });
      });

      const doisQuadros = () =>
        new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));

      janela.__orbita = async (theta: number, phi: number) => {
        mv.setAttribute('camera-orbit', `${theta}deg ${phi}deg 95%`);
        await mv.updateComplete;
        await doisQuadros();
      };
    </script>
  </body>
</html>
