---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Sidebar from '../../components/Sidebar.astro';
import Faq from '../../components/home/Faq.astro';
import { getCollection } from 'astro:content';
import { metaDescricao } from '../../lib/text';

export async function getStaticPaths() {
  const items = await getCollection('servicos');
  return items.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const faqs = (await getCollection('faq')).slice(0, 6);
const descricao = metaDescricao(entry.data.html);

const servicoSchema = {
  '@type': 'Service',
  name: entry.data.title,
  serviceType: entry.data.title,
  description: descricao,
  provider: { '@id': 'https://grupomegaelite.com.br/#empresa' },
  areaServed: { '@type': 'City', name: 'Anápolis' },
  url: `https://grupomegaelite.com.br/servicos/${entry.data.slug}.html`,
};
const trilhaSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://grupomegaelite.com.br/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Serviços',
      item: 'https://grupomegaelite.com.br/servicos/',
    },
    { '@type': 'ListItem', position: 3, name: entry.data.title },
  ],
};
---
<Base title={entry.data.title} description={descricao} schemas={[servicoSchema, trilhaSchema]}>
  <Breadcrumbs items={[{ label: 'Serviços', href: '/servicos/' }, { label: entry.data.title }]} />
  <div class="container">
    <div class="row mb-3">
      <article class="card col-lg-9 col-md-8 col-12">
        <div class="page-content card-body">
          <header class="post-header mb-4">
            <h1 class="post-title display-5 fw-bold text-dark mb-3">{entry.data.title}</h1>
          </header>
          <div class="post-content mb-5">
            <div class="content-wrapper" set:html={entry.data.html}></div>
          </div>
        </div>
      </article>
      <Sidebar />
    </div>
  </div>
  <Faq items={faqs} />
</Base>
