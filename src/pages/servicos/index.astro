---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardServico from '../../components/CardServico.astro';
import { getCollection } from 'astro:content';

const servicos = (await getCollection('servicos')).sort(
  (a, b) => (a.data.date || '').localeCompare(b.data.date || '')
);

const listaSchema = {
  '@type': 'ItemList',
  name: 'Serviços do Grupo Mega Elite',
  itemListElement: servicos.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: `https://grupomegaelite.com.br/servicos/${s.data.slug}.html`,
  })),
};
---
<Base
  title="Serviços de Segurança Privada em Anápolis"
  description="Vigilância armada e desarmada, portaria presencial e remota, monitoramento 24h, escolta armada e limpeza profissional em Anápolis e região."
  schemas={[listaSchema]}
>
  <Breadcrumbs items={[{ label: 'Serviços' }]} />
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-md-12">
        <header class="mb-4">
          <h1 class="display-5 fw-bold mb-3">Serviços de segurança em Anápolis e região</h1>
          <p class="lead text-muted">
            Vigilância, portaria, monitoramento 24h, escolta armada e limpeza profissional
            para condomínios, empresas, indústrias e residências.
          </p>
        </header>

        <div class="row g-4 mb-5">
          {servicos.map((s) => (
            <div class="col-6 col-md-4">
              <CardServico servico={s} nivel={2} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
