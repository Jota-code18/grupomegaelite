---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/home/Faq.astro';
import { getCollection } from 'astro:content';
import { metaDescricao, textoLimpo } from '../../lib/text';

export async function getStaticPaths() {
  const items = await getCollection('faq');
  return items.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const faqs = (await getCollection('faq')).slice(0, 6);
const resposta = textoLimpo(entry.data.html);

// Pergunta isolada em QAPage: é assim que buscadores com IA extraem a resposta.
const perguntaSchema = {
  '@type': 'QAPage',
  mainEntity: {
    '@type': 'Question',
    name: entry.data.title,
    acceptedAnswer: { '@type': 'Answer', text: resposta },
  },
};
---
<Base
  title={entry.data.title}
  description={metaDescricao(entry.data.html)}
  schemas={[perguntaSchema]}
>
  <Breadcrumbs items={[{ label: 'Faq', href: '/faq/' }, { label: entry.data.title }]} />
  <div class="container">
    <div class="row mb-3">
      <article class="card col-12">
        <div class="page-content card-body">
          <header class="post-header mb-4">
            <h1 class="post-title display-5 fw-bold text-dark mb-3">{entry.data.title}</h1>
          </header>
          <div class="post-content mb-5">
            <div class="content-wrapper" set:html={entry.data.html}></div>
          </div>
        </div>
      </article>
    </div>
  </div>
  <Faq items={faqs} />
</Base>
