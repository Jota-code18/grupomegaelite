---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Localizacao from '../../components/Localizacao.astro';
import site from '../../data/site.json';
---
<Base title="Contato">
  <Breadcrumbs items={[{ label: 'Contato' }]} />
  <section class="py-5">
    <div class="container">
      <h2 class="title-main-section">Fale com a gente!<span></span></h2>
      <p>
        Estamos prontos para atender você pelo
        <a href={site.contato.whatsapp_link} target="_blank" rel="noopener" style="color:#25D366; text-decoration:none;">{site.contato.whatsapp_display}</a>,
        ou, se preferir, envie um e-mail para
        <a href="mailto:contato@grupomegaelite.com.br?subject=Contato%20pelo%20site" style="color:#0073e6; text-decoration:none;">{site.contato.email}</a>
        <br />
        Faça-nos uma visita: <strong>{site.contato.address}</strong>
      </p>

      <form
        class="mega-form row g-3 mt-2"
        data-whatsapp={site.form_whatsapp}
        data-email={site.form_email}
        novalidate
      >
        <div class="col-md-6">
          <label class="form-label" for="f-nome">Nome</label>
          <input type="text" id="f-nome" name="nome" class="form-control" required autocomplete="name" />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="f-telefone">Telefone</label>
          <input type="tel" id="f-telefone" name="telefone" class="form-control" autocomplete="tel" placeholder="(62) 90000-0000" />
        </div>
        <div class="col-12">
          <label class="form-label" for="f-assunto">Assunto</label>
          <input type="text" id="f-assunto" name="assunto" class="form-control" required placeholder="Ex.: orçamento de portaria remota" />
        </div>
        <div class="col-12">
          <label class="form-label" for="f-mensagem">Mensagem</label>
          <textarea id="f-mensagem" name="mensagem" rows="5" class="form-control" required></textarea>
        </div>
        <div class="col-12 d-flex flex-wrap align-items-center gap-3">
          <button type="submit" class="btn btn-orcamento">
            <i class="fab fa-whatsapp" aria-hidden="true"></i> Enviar pelo WhatsApp
          </button>
          <button type="button" class="btn btn-outline-primary btn-sm" data-send="email">
            <i class="fas fa-envelope me-1" aria-hidden="true"></i> Prefiro enviar por e-mail
          </button>
        </div>
        <p class="col-12 form-hint mb-0" role="status">
          Ao enviar, abrimos a conversa já com a sua mensagem escrita — é só apertar enviar.
        </p>
      </form>
    </div>

    <Localizacao />
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form.mega-form');
  if (form) {
    const hint = form.querySelector<HTMLElement>('.form-hint');
    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';

    const compose = () => {
      const linhas = [
        `Olá! Meu nome é ${val('nome')}.`,
        '',
        `Assunto: ${val('assunto')}`,
        '',
        val('mensagem'),
      ];
      const tel = val('telefone');
      if (tel) linhas.push('', `Meu telefone: ${tel}`);
      return linhas.join('\n');
    };

    const validar = () => {
      let ok = true;
      for (const nome of ['nome', 'assunto', 'mensagem']) {
        const campo = form.elements.namedItem(nome) as HTMLInputElement | null;
        if (!campo) continue;
        const vazio = !campo.value.trim();
        campo.classList.toggle('is-invalid', vazio);
        if (vazio && ok) {
          campo.focus();
          ok = false;
        }
      }
      if (!ok && hint) {
        hint.textContent = 'Preencha nome, assunto e mensagem para continuar.';
        hint.style.color = '#b3261e';
      }
      return ok;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validar()) return;
      const numero = form.dataset.whatsapp;
      window.open(`https://wa.me/${numero}?text=${encodeURIComponent(compose())}`, '_blank', 'noopener');
    });

    form.querySelector('[data-send="email"]')?.addEventListener('click', () => {
      if (!validar()) return;
      const assunto = encodeURIComponent(`Site Mega Elite — ${val('assunto')}`);
      window.location.href = `mailto:${form.dataset.email}?subject=${assunto}&body=${encodeURIComponent(compose())}`;
    });

    form.addEventListener('input', (e) => {
      (e.target as HTMLElement).classList.remove('is-invalid');
    });
  }
</script>
