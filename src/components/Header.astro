---
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\/index\.html$/, '/');
---
<header class="site-header">
  <div class="container p-0">
    <div class="header-bar d-flex align-items-center justify-content-center justify-content-md-between">
      <nav class="d-none d-md-block main-navigation" aria-label="Menu principal">
        <ul class="nav mb-0" id="primary-menu">
          {site.menu.map((m) => (
            <li class="nav-item">
              <a class={`nav-link${m.href === path ? ' active' : ''}`} href={m.href} aria-current={m.href === path ? 'page' : undefined}>{m.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href={site.cta.href} class="btn btn-orcamento">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> {site.cta.label}
      </a>
    </div>
  </div>
</header>
