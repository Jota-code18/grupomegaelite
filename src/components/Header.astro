---
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\/index\.html$/, '/');
---
<header class="site-header">
  <div class="container p-0">
    <div class="header-bar d-flex align-items-center justify-content-between">
      <!-- Mobile: abre o menu. Desktop: escondido (o menu já está visível). -->
      <button
        class="header-toggle d-lg-none"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu-mobile"
        aria-controls="menu-mobile"
        aria-expanded="false"
        aria-label="Abrir menu"
      >
        <span class="header-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        Menu
      </button>

      <nav class="d-none d-lg-block main-navigation" aria-label="Menu principal">
        <ul class="nav mb-0" id="primary-menu">
          {site.menu.map((m) => (
            <li class="nav-item">
              <a class={`nav-link${m.href === path ? ' active' : ''}`} href={m.href} aria-current={m.href === path ? 'page' : undefined}>{m.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href={site.cta.href} class="btn btn-orcamento">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> <span>{site.cta.label}</span>
      </a>
    </div>

    <div class="collapse d-lg-none" id="menu-mobile">
      <nav class="header-drawer" aria-label="Menu">
        <ul>
          {site.menu.map((m) => (
            <li><a href={m.href} class={m.href === path ? 'is-active' : undefined}>{m.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
