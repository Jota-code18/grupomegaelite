---
import site from '../../data/site.json';
---
<section class="hero-elite" aria-label="Grupo Mega Elite">
  <div class="hero-elite__stage" data-loading="true">
    <model-viewer
      class="hero-elite__model"
      src="/models/elite-3d.glb"
      alt="Escudo tridimensional do Grupo Elite — Vigilância e Segurança 24 horas"
      camera-controls
      disable-zoom
      disable-pan
      touch-action="pan-y"
      interaction-prompt="none"
      shadow-intensity="0.85"
      shadow-softness="1"
      exposure="1.1"
      environment-image="neutral"
      camera-orbit="0deg 82deg 95%"
      loading="eager"
    ></model-viewer>
    <div class="hero-elite__spinner" aria-hidden="true"><span></span></div>
  </div>

  <div class="hero-elite__panel">
    <h1>Proteção que inspira confiança.</h1>
    <p class="hero-elite__lead">
      Há 30 anos protegendo pessoas, empresas e condomínios em Anápolis e região —
      com central de monitoramento própria, equipes treinadas e tecnologia de ponta.
    </p>

    <ul class="hero-elite__facts">
      <li><i class="fas fa-tower-broadcast" aria-hidden="true"></i> Central de monitoramento 24 horas</li>
      <li><i class="fas fa-shield-halved" aria-hidden="true"></i> Vigilância armada e desarmada</li>
      <li><i class="fas fa-building-shield" aria-hidden="true"></i> Portaria presencial e remota</li>
      <li><i class="fas fa-truck-fast" aria-hidden="true"></i> Escolta armada e limpeza profissional</li>
    </ul>

    <div class="hero-elite__cta">
      <a href={site.cta.href} class="btn btn-orcamento">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> {site.cta.label}
      </a>
      <a href={`tel:+55${site.topbar.phone.replace(/\D/g, '')}`} class="hero-elite__phone">
        <i class="fas fa-phone" aria-hidden="true"></i> {site.topbar.phone}
      </a>
    </div>
  </div>
</section>

<script>
  import '@google/model-viewer';

  const stage = document.querySelector<HTMLElement>('.hero-elite__stage');
  const viewer = stage?.querySelector('model-viewer');

  if (stage && viewer) {
    const done = () => stage.removeAttribute('data-loading');
    viewer.addEventListener('load', done, { once: true });
    viewer.addEventListener('error', done, { once: true });
    // Segurança: nunca deixa o palco preso no estado de carregamento
    setTimeout(done, 8000);

    // Balanço suave: o escudo é achatado, então girar 360° o deixaria de perfil.
    // Oscilamos em torno da frente — dá vida sem esconder a marca.
    const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');
    const AMPLITUDE = 17; // graus
    const PERIODO = 11000; // ms por ciclo
    let inicio: number | null = null;
    let quadro = 0;
    let visivel = true;
    let interagiu = false;

    const passo = (agora: number) => {
      if (inicio === null) inicio = agora;
      const t = ((agora - inicio) / PERIODO) * Math.PI * 2;
      const theta = Math.sin(t) * AMPLITUDE;
      const phi = 82 + Math.cos(t * 0.6) * 3.5;
      viewer.setAttribute('camera-orbit', `${theta.toFixed(2)}deg ${phi.toFixed(2)}deg 95%`);
      quadro = requestAnimationFrame(passo);
    };

    const tocar = () => {
      if (quadro || interagiu || !visivel || semMovimento.matches) return;
      inicio = null;
      quadro = requestAnimationFrame(passo);
    };
    const parar = () => {
      cancelAnimationFrame(quadro);
      quadro = 0;
    };

    // Ao arrastar, o controle é do usuário — o balanço não volta a disputar.
    viewer.addEventListener('camera-change', (e: Event) => {
      if ((e as CustomEvent).detail?.source === 'user-interaction') {
        interagiu = true;
        parar();
      }
    });

    // Não gasta bateria quando o herói está fora da tela.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entrada]) => {
          visivel = entrada.isIntersecting;
          visivel ? tocar() : parar();
        },
        { threshold: 0.05 }
      ).observe(stage);
    }

    semMovimento.addEventListener('change', () => (semMovimento.matches ? parar() : tocar()));
    tocar();
  }
</script>
