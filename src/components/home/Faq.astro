---
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'faq'>[]; }
const { items } = Astro.props;
---
<section class="faq">
  <div class="container">
    <div class="row">
      <div class="col-lg-5 col-md-5 col-12 py-5">
        <h2 class="title-main-section">Perguntas Frequentes <span></span></h2>
        <p>A MEGA ELITE oferece soluções completas em segurança e manutenção, incluindo: vigilância armada e desarmada, portaria presencial e remota, monitoramento de alarmes e câmeras 24h.</p>
        <a href="/faq/" class="btn btn-primary">Veja Mais</a>
      </div>

      <div class="col-lg-7 col-md-7 col-12">
        <div class="accordion" id="faqAccordion">
          {items.map((f, idx) => {
            const i = idx + 1;
            return (
              <div class="accordion-item">
                <h3 class="accordion-header" id={`heading${i}`}>
                  <button
                    class={`accordion-button ${i === 1 ? '' : 'collapsed'}`}
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target={`#collapse${i}`}
                    aria-expanded={i === 1 ? 'true' : 'false'}
                    aria-controls={`collapse${i}`}>
                    {f.data.title}
                  </button>
                </h3>
                <div id={`collapse${i}`} class={`accordion-collapse collapse ${i === 1 ? 'show' : ''}`} aria-labelledby={`heading${i}`} data-bs-parent="#faqAccordion">
                  <div class="accordion-body" set:html={f.data.html}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
