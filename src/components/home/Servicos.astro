---
import type { CollectionEntry } from 'astro:content';
import CardServico from '../CardServico.astro';

interface Props {
  items: CollectionEntry<'servicos'>[];
}
const { items } = Astro.props;
---
<section class="section_001">
  <div class="container">
    <div class="secao-cabecalho">
      <h2 class="title-main-section">Protegendo hoje, pensando no amanhã. <span></span></h2>
      <a href="/telefones/" class="btn btn-orcamento">
        <i class="fab fa-whatsapp" aria-hidden="true"></i> FAÇA SEU ORÇAMENTO
      </a>
    </div>

    <div class="row g-4">
      {items.map((s) => (
        <div class="col-6 col-md-3">
          <CardServico servico={s} nivel={3} />
        </div>
      ))}
    </div>
  </div>
</section>
