---
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'servicos'>[]; }
const { items } = Astro.props;
---
<section class="section_001">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between">
      <h2 class="title-main-section">Protegendo hoje, pensando no amanhã. <span></span></h2>
      <a href="/telefones/" class="btn btn-primary" style="color:#111; font-weight: bold;">
        <i class="fab fa-whatsapp me-1"></i> FAÇA SEU ORÇAMENTO
      </a>
    </div>

    <div class="row">
      {items.map((s) => (
        <div class="col-sm-6 col-md-3 mb-4">
          <div class="my-card-site">
            <a href={`/servicos/${s.data.slug}.html`}><figure><img src={s.data.image} alt={s.data.title} /></figure></a>
            <a href={`/servicos/${s.data.slug}.html`}><h5>{s.data.title}</h5></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
