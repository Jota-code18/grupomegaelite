---
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const servicos = (await getCollection('servicos')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'pt-BR')
);
const ano = new Date().getFullYear();
const telHref = `tel:+55${site.topbar.phone.replace(/\D/g, '')}`;
---
<div class="tarja-logo">
  <img src="/img/logo-grande.png" alt={site.name} class="img-fluid" width="220" height="220" loading="lazy" />
</div>

<footer class="rodape-elite">
  <div class="container">
    <div class="rodape-elite__grid">
      <div class="rodape-elite__marca">
        <p>
          Segurança patrimonial em Anápolis e região há 30 anos: vigilância, portaria,
          monitoramento 24 horas, escolta armada e limpeza profissional.
        </p>
        <div class="rodape-elite__social">
          <a href={site.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook do Grupo Mega Elite">
            <i class="fab fa-facebook-f" aria-hidden="true"></i>
          </a>
          <a href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram do Grupo Mega Elite">
            <i class="fab fa-instagram" aria-hidden="true"></i>
          </a>
          <a href={site.socials.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp do Grupo Mega Elite">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <nav class="rodape-elite__coluna" aria-labelledby="rodape-navegar">
        <h2 id="rodape-navegar">Navegar</h2>
        <ul>
          {site.menu.map((m) => (
            <li><a href={m.href}>{m.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="rodape-elite__coluna" aria-labelledby="rodape-servicos">
        <h2 id="rodape-servicos">Serviços</h2>
        <ul>
          {servicos.map((s) => (
            <li><a href={`/servicos/${s.data.slug}.html`}>{s.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <div class="rodape-elite__coluna" aria-labelledby="rodape-contato">
        <h2 id="rodape-contato">Contato</h2>
        <ul class="rodape-elite__contato">
          <li>
            <i class="fas fa-location-dot" aria-hidden="true"></i>
            <span>{site.topbar.address}</span>
          </li>
          <li>
            <i class="fas fa-phone" aria-hidden="true"></i>
            <a href={telHref}>{site.topbar.phone}</a>
          </li>
          <li>
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <a href={`mailto:${site.contato.email}`}>{site.contato.email}</a>
          </li>
          <li>
            <i class="fas fa-tower-broadcast" aria-hidden="true"></i>
            <span>Central de monitoramento 24 horas</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="rodape-elite__base">
      <p>© {ano} {site.name} — Vigilância e Segurança. Todos os direitos reservados.</p>
      <ul>
        <li><a href="/termos-de-uso/">Termos de Uso</a></li>
        <li><a href="/politica-de-privacidade/">Política de Privacidade</a></li>
        <li><a href="/adequacao-a-lgpd/">Adequação à LGPD</a></li>
      </ul>
    </div>
  </div>
</footer>
