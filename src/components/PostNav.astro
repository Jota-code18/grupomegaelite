---
interface Link { href: string; title: string; }
interface Props { prev?: Link | null; next?: Link | null; }
const { prev, next } = Astro.props;
---
<nav class="post-navigation mb-4" aria-label="Navegação entre posts">
  <div class="row">
    <div class="col-md-6">
      {prev && (
        <div class="card">
          <div class="card-body">
            <h6 class="badge bg-secondary bg-opacity-10 text-secondary text-decoration-none me-1"><i class="fas fa-chevron-left me-1"></i>Post Anterior</h6>
            <p class="card-title"><a href={prev.href} class="text-decoration-none text-dark stretched-link">{prev.title}</a></p>
          </div>
        </div>
      )}
    </div>
    <div class="col-md-6">
      {next && (
        <div class="card">
          <div class="card-body">
            <h6 class="badge bg-primary bg-opacity-10 text-primary text-decoration-none me-1">Próximo Post <i class="fas fa-chevron-right ms-1"></i></h6>
            <p class="card-title"><a href={next.href} class="text-decoration-none text-dark stretched-link">{next.title}</a></p>
          </div>
        </div>
      )}
    </div>
  </div>
</nav>
