---
import site from '../data/site.json';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import '../styles/ui.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass = '' } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.name;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{fullTitle}</title>

    <!-- Ativa o motion antes do paint (evita flash) — só se o usuário não pediu menos movimento -->
    <script is:inline>
      (function () {
        try {
          if (!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
            document.documentElement.classList.add('js-motion');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2056339778493739');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2056339778493739&ev=PageView&noscript=1" /></noscript>
    <!-- End Meta Pixel Code -->

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WJC4HVCR');
    </script>
    <!-- End Google Tag Manager -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/tema-base.css" />
    <link rel="stylesheet" href="/css/tema.css" />
    <style is:inline>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    </style>
  </head>

  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WJC4HVCR" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <Header />
    <MobileMenu />

    <main>
      <slot />
    </main>

    <Footer />

    <script is:inline src="/js/jquery.min.js"></script>
    <script is:inline src="/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/js/js.js"></script>

    <!-- Motion: revelação ao rolar, lazy/fade/skeleton de imagens, barra de progresso -->
    <script is:inline>
      (function () {
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Revelação ao rolar (entrada)
        var sel =
          '.title-main-section, .my-card-site, .card-noticias-home, article.card, .galeria-carrossel-wrapper, .empresa .row, .accordion, .post-navigation, .social-share, .conteudos-sugeridos';
        var targets = Array.prototype.slice.call(document.querySelectorAll(sel));
        document.querySelectorAll('.row').forEach(function (row) {
          var i = 0;
          row.querySelectorAll('.my-card-site, .card-noticias-home').forEach(function (c) {
            c.style.setProperty('--reveal-delay', (i % 4) * 70 + 'ms');
            i++;
          });
        });
        if ('IntersectionObserver' in window && targets.length) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-revealed');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
          );
          targets.forEach(function (el) { io.observe(el); });
          // Segurança: revela tudo depois de 1,5s (nada fica preso)
          setTimeout(function () { targets.forEach(function (el) { el.classList.add('is-revealed'); }); }, 1500);
        } else {
          targets.forEach(function (el) { el.classList.add('is-revealed'); });
        }

        // Imagens: lazy + fade-in + skeleton (pula logos, topbar e o slideshow-herói)
        document.querySelectorAll('img').forEach(function (img) {
          if (img.closest('.site-header, footer, .footer_02, .topbar, .tarja-logo, #carouselSlides')) return;
          if (!img.hasAttribute('loading')) img.loading = 'lazy';
          img.decoding = 'async';
          img.classList.add('img-fx');
          var fig = img.closest('figure, .card-img-top, .post-thumbnail');
          if (fig) fig.classList.add('media-skeleton');
          var done = function () {
            img.classList.add('is-loaded');
            if (fig) fig.classList.add('is-loaded');
          };
          if (img.complete && img.naturalWidth) done();
          else {
            img.addEventListener('load', done, { once: true });
            img.addEventListener('error', done, { once: true });
          }
        });

        // Barra de progresso de navegação (só aparece se demorar > 180ms)
        var bar = document.createElement('div');
        bar.className = 'route-progress';
        document.body.appendChild(bar);
        var timer;
        document.addEventListener(
          'click',
          function (ev) {
            var a = ev.target.closest ? ev.target.closest('a') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (a.target === '_blank' || a.hasAttribute('download')) return;
            if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0) return;
            if (/^https?:\/\//.test(href) && a.host !== location.host) return;
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
            timer = setTimeout(function () {
              bar.classList.add('is-active');
              requestAnimationFrame(function () { bar.style.transform = 'scaleX(0.85)'; });
            }, 180);
          },
          true
        );
        window.addEventListener('pagehide', function () { clearTimeout(timer); });
      })();
    </script>
  </body>
</html>
